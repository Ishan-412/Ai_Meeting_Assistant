# Select the LLM backend: gemini or openrouter
LLM_PROVIDER=gemini

# Gemini (used when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Hinglish transcription (optional; English uses local Whisper)
SARVAM_API_KEY=

# Optional audio/model settings
SARVAM_STT_MODEL=saaras:v2.5
WHISPER_MODEL=small
# FFMPEG_PATH=/path/to/ffmpeg
